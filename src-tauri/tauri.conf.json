{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "T-DoList",
  "version": "0.2.0",
  "identifier": "com.atao.t-dolist",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "T-DoList",
        "width": 400,
        "height": 56,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.svg"
    ]
  }
}
